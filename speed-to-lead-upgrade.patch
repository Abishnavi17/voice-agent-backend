+# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
+# `docker compose up` reads .env automatically.
+
+# --- Secrets you invent (long random strings, e.g. `openssl rand -hex 32`) ---
+# Protects POST /leads, GET /leads, GET /appointments (send as header X-API-Key).
+LEADS_API_KEY=
+# Protects POST /vapi/webhook. Put the SAME value in the Vapi custom credential.
+WEBHOOK_SECRET=
+
+# --- Vapi (https://dashboard.vapi.ai) ---
+VAPI_API_KEY=            # private API key
+VAPI_ASSISTANT_ID=       # printed by `python -m scripts.create_assistant`
+VAPI_PHONE_NUMBER_ID=    # the number that places the calls
+
+# --- The business the agent speaks for ---
+BUSINESS_NAME=Acme Solar
+BUSINESS_TZ=Asia/Kolkata          # IANA timezone name
+BUSINESS_HOURS=09:00-18:00        # when consultations can be booked
+WORKDAYS=0,1,2,3,4                # Monday=0 ... Sunday=6
+SLOT_MINUTES=30
+BOOKING_HORIZON_DAYS=7
+MIN_NOTICE_MINUTES=60
+
+# --- Outbound calling rules ---
+CALL_WINDOW=09:00-20:00           # only phone leads inside these local hours
+DEFAULT_COUNTRY_CODE=+91          # added to numbers typed without a country code
+DEDUPE_MINUTES=10                 # same number within this time = ignored as a double submit
+
+# --- Optional: Slack incoming webhook / Zapier / Make URL for booking + hot-lead alerts ---
+NOTIFY_WEBHOOK_URL=
